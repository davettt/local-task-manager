{
  "name": "local-task-manager",
  "version": "1.9.0",
  "description": "A lightweight task management application with integrated timer, pomodoro timer option, calendar appointment reminders, recurring tasks, gamification, archive management, terminal mantra, and server reliability features",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src/ public/js/",
    "lint:fix": "eslint src/ public/js/ --fix",
    "format": "prettier --write src/ public/",
    "format:check": "prettier --check src/ public/",
    "audit:security": "npm audit",
    "quality": "npm run lint && npm run format:check && npm run audit:security",
    "prepare": "husky"
  },
  "keywords": [
    "task",
    "timer",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@linear/cli": "^0.0.5",
    "eslint": "^9.39.2",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.0.3"
  }
}
